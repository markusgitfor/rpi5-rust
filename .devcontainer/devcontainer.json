{
  "name": "Raspberry Pi 5 Environment",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "runArgs": [
    "--privileged",
    "--network=host"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.flake8",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "google.google-antigravity"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "flake8.args": [
          "--max-line-length=120",
          "--exclude=venv,.venv"
        ]
      }
    }
  },
  "postCreateCommand": "uv sync",
  "remoteUser": "vscode"
}

